# ─── Copiar a .env y completar. .env NUNCA se versiona. ───────────────────────

APP_ENV=dev                      # dev | prod
APP_SECRET_KEY=cambiar-esto-en-produccion
APP_TIMEZONE=America/Santiago

# ─── Base de datos ───────────────────────────────────────────────────────────
# dev  : SQLite local, sin instalar nada
# prod : Supabase / Postgres  ->  postgresql+psycopg://USER:PASS@HOST:5432/postgres
DATABASE_URL=sqlite+pysqlite:///var/data/sgl.sqlite3

# ─── Mercado Público (PRD §4.2) ──────────────────────────────────────────────
# Ticket personal solicitado con Clave Única. Llega por correo. NO commitear.
# Vacío => el sistema usa el provider de fixtures (respuestas reales guardadas).
MP_TICKET=
MP_BASE_URL=https://api.mercadopublico.cl/servicios/v1/publico/
MP_CUOTA_DIARIA=10000            # tope duro del ticket, no modificable al alza
MP_UMBRAL_DEGRADACION=0.80       # al 80% el sistema degrada y avisa al admin
MP_VENTANA_BATCH_INICIO=22       # hora local: cargas masivas 22:00-07:00
MP_VENTANA_BATCH_FIN=7
MP_TIMEOUT_SEG=45
MP_REINTENTOS=3
MP_CACHE_TTL_ACTIVAS_MIN=240     # licitaciones activas: refresco cada 4h
MP_CACHE_TTL_CERRADAS_DIAS=30    # cerradas/adjudicadas: casi inmutables

# ─── Scraper de anexos (PRD RF-2.3) ──────────────────────────────────────────
SCRAPER_HABILITADO=false         # arranca apagado: revisar términos de uso primero
SCRAPER_USER_AGENT=sgl-ito-serviu/0.1 (+mailto:CONTACTO@empresa.cl)
SCRAPER_CONTACTO_EMAIL=
SCRAPER_DELAY_SEG=5              # delay entre requests. Cola secuencial, sin paralelismo
SCRAPER_MAX_LICITACIONES_DIA=10  # tope diario, valor inicial deliberadamente bajo
SCRAPER_RESPETAR_ROBOTS=true

# ─── LLM (PRD §4.4) ──────────────────────────────────────────────────────────
# Vacío => provider 'null': no llama a nadie y lo deja explícito en la UI.
LLM_PROVIDER=null                # null | gemini
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
LLM_RPM=10                       # free tier: ~10-15 RPM
LLM_MAX_REQUESTS_DIA=1000

# ─── Almacenamiento de archivos ──────────────────────────────────────────────
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_RAIZ=var/files
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Notificaciones (M10) ────────────────────────────────────────────────────
NOTIFY_BACKENDS=consola          # consola,email,whatsapp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Ingesta del correo de Mercado Público (RF-10.3)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
