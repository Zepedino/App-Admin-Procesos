# Secretos — NUNCA versionar (PRD §6 Seguridad)
.env
.env.*
!.env.example
*.pem
*.key

# Datos: base de datos y archivos descargados. Se recrean solos.
# OJO: datos/ (con barra) no alcanza a datos_demo/, que SI se versiona.
datos/
*.sqlite3
*.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Editores / SO
.idea/
.DS_Store
Thumbs.db

# NOTA: .vscode/ SI se versiona. Lleva la configuracion del boton Run y del
# interprete, que es justo lo que evita que alguien tenga que pelear con la
# terminal para levantar la aplicacion.

# Informes generados: son salida del comando `consola informe`, no fuente.
# Se regeneran con un comando, y versionarlos llenaría el historial de
# archivos de 400 KB que cambian entero en cada corrida.
informe/
